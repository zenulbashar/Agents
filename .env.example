# =============================================================================
# Foundry — environment configuration TEMPLATE
# =============================================================================
# Copy to `.env` and fill in. For ANYTHING secret, prefer pulling at runtime
# from Vault/OpenBao or 1Password (see docs/11-security-architecture.md) instead
# of leaving long-lived secrets in this file. `.env` is gitignored.
# -----------------------------------------------------------------------------

# ---- Core ----
FOUNDRY_ENV=local                       # local | staging
FOUNDRY_AUTONOMY_LEVEL=1                 # 0=approve-all 1=semi 2=project 3=near-full
FOUNDRY_DATA_DIR=./data
TZ=Europe/London

# ---- Operator identity (for approval gates / audit attribution) ----
OPERATOR_NAME="Your Name"
OPERATOR_EMAIL=you@example.com

# =============================================================================
# MODELS
# =============================================================================
# ---- Local (Ollama, runs natively on the Mac for Metal acceleration) ----
OLLAMA_HOST=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text        # 768-dim, fast, local

# ---- Cloud burst (only the keys you actually use; leave others blank) ----
# Anthropic Claude is the primary cloud tier for architecture/security/review.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=                        # optional: cloud DeepSeek for cheap reasoning

# Per-day spend cap (USD) enforced by the model router circuit breaker.
CLOUD_DAILY_BUDGET_USD=25

# =============================================================================
# MEMORY / DATA STORES  (defaults match docker/docker-compose.yml)
# =============================================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=foundry
POSTGRES_USER=foundry
POSTGRES_PASSWORD=change-me-via-vault

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=change-me-via-vault

REDIS_URL=redis://127.0.0.1:6379/0

# Optional knowledge graph (Phase 3+)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-via-vault

# =============================================================================
# CODE / CI
# =============================================================================
GIT_PROVIDER=gitea                       # gitea (self-host) | github
GITEA_URL=http://127.0.0.1:3000
GITEA_TOKEN=change-me-via-vault
GITHUB_TOKEN=                            # only if GIT_PROVIDER=github

# =============================================================================
# IDENTITY / SECRETS / ACCESS
# =============================================================================
AUTHENTIK_URL=http://127.0.0.1:9000      # internal OIDC IdP for app-level authz
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-via-vault

VAULT_ADDR=http://127.0.0.1:8200         # HashiCorp Vault / OpenBao
VAULT_TOKEN=                             # short-lived; do not persist

TAILSCALE_TAILNET=your-tailnet.ts.net
CLOUDFLARE_TUNNEL_TOKEN=                 # only for intentionally-public surfaces

# =============================================================================
# OBSERVABILITY
# =============================================================================
LANGFUSE_HOST=http://127.0.0.1:3001      # LLM tracing/evals
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GRAFANA_URL=http://127.0.0.1:3002
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
