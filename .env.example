# =============================================================================
# Foundry — environment configuration TEMPLATE
# =============================================================================
# Copy to `.env` and fill in. For ANYTHING secret, prefer pulling at runtime
# from Vault/OpenBao or 1Password (see docs/11-security-architecture.md) instead
# of leaving long-lived secrets in this file. `.env` is gitignored.
# -----------------------------------------------------------------------------

# ---- Core ----
FOUNDRY_ENV=local                       # local | staging
FOUNDRY_AUTONOMY_LEVEL=1                 # 0=approve-all 1=semi 2=project 3=near-full
FOUNDRY_DATA_DIR=./data
TZ=Australia/Brisbane                    # operator timezone; foundryd cron + logs use this

# ---- Operator identity (for approval gates / audit attribution) ----
OPERATOR_NAME="Your Name"
OPERATOR_EMAIL=you@example.com

# =============================================================================
# MODELS
# =============================================================================
# ---- Local (Ollama, runs natively on the Mac for Metal acceleration) ----
OLLAMA_HOST=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text        # 768-dim, fast, local

# ---- Cloud burst (ALL-LOCAL default: leave every key BLANK -> no cloud call is possible) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=                        # optional: cloud DeepSeek for cheap reasoning

# Per-day cloud spend cap (USD), enforced by the model router circuit breaker.
# 0 = ALL-LOCAL, $0 marginal cost (default). Runtime uses Ollama only; every cloud
# tier falls back to local (config/models.yaml mode: local-only). Raise this AND add
# a key above only if you want cloud frontier help on the hardest gates.
CLOUD_DAILY_BUDGET_USD=0

# =============================================================================
# MEMORY / DATA STORES  (defaults match docker/docker-compose.yml)
# =============================================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=foundry
POSTGRES_USER=foundry
POSTGRES_PASSWORD=change-me-via-vault

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=change-me-via-vault

REDIS_URL=redis://127.0.0.1:6379/0

# Optional knowledge graph (Phase 3+)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-via-vault

# =============================================================================
# CODE / CI
# =============================================================================
GIT_PROVIDER=gitea                       # gitea (self-host) | github
GITEA_URL=http://127.0.0.1:3000
GITEA_TOKEN=change-me-via-vault
GITHUB_TOKEN=                            # only if GIT_PROVIDER=github

# =============================================================================
# IDENTITY / SECRETS / ACCESS
# =============================================================================
AUTHENTIK_URL=http://127.0.0.1:9000      # internal OIDC IdP for app-level authz
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-via-vault

VAULT_ADDR=http://127.0.0.1:8200         # HashiCorp Vault / OpenBao
VAULT_TOKEN=                             # short-lived; do not persist

TAILSCALE_TAILNET=your-tailnet.ts.net
CLOUDFLARE_TUNNEL_TOKEN=                 # only for intentionally-public surfaces

# =============================================================================
# SUPPORT API  (services/support_api — Contract v1; docker/support-api.yml)
# =============================================================================
# Postgres for the support stack (compose creates both roles on first boot).
SUPPORT_POSTGRES_DB=foundry_support
SUPPORT_POSTGRES_USER=foundry
SUPPORT_POSTGRES_PASSWORD=change-me-via-vault
SUPPORT_APP_DB_PASSWORD=change-me-via-vault        # RLS-enforced app role

# Running outside compose? Point straight at the DB (app role + owner role).
SUPPORT_DATABASE_URL=postgresql://support_api_app:change-me@127.0.0.1:5432/foundry_support
SUPPORT_MAINTENANCE_DATABASE_URL=postgresql://foundry:change-me@127.0.0.1:5432/foundry_support

# Per-app credentials (one trio per app_id in config/support_api.yaml).
SUPPORT_PUBLIC_KEY_PROMPT2EAT=                     # PEM or base64 raw Ed25519 pubkey
SUPPORT_HMAC_SECRET_PROMPT2EAT=                    # shared secret for X-Signature
SUPPORT_WEBHOOK_SECRET_PROMPT2EAT=                 # signs outbound webhooks

SUPPORT_OPERATOR_TOKEN=                            # guards /internal/* (ticket replies)
SUPPORT_PUBLIC_BASE_URL=                           # e.g. https://support.foundry.example
SUPPORT_DOMAIN=                                    # Caddy vhost; empty => localhost
SUPPORT_MODEL=claude-haiku-4-5-20251001            # Haiku-class for routine turns
SUPPORT_DAILY_TOKEN_BUDGET=500000                  # per (app, tenant) per UTC day
SUPPORT_CONVERSATION_TOKEN_BUDGET=50000
SUPPORT_RETENTION_DAYS=90                          # transcript purge window

# =============================================================================
# OBSERVABILITY
# =============================================================================
LANGFUSE_HOST=http://127.0.0.1:3001      # LLM tracing/evals
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GRAFANA_URL=http://127.0.0.1:3002
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
