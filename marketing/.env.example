# marketing/.env.example - copy to .env (gitignored). Real secrets never in the repo.
N8N_ENCRYPTION_KEY=<output of: openssl rand -hex 32>
# ^ generate ONCE. n8n encrypts every stored API credential with this key. Lose it and
#   every credential on a migrated machine is unrecoverable. Back it up in your password manager.

# AI endpoint - swappable per your standing principle (config, not code):
AI_BASE_URL=http://host.docker.internal:11434/v1   # Ollama (free, local)
# AI_BASE_URL=https://openrouter.ai/api/v1         # hosted, for a 4GB VPS
AI_MODEL=llama3.1:8b
