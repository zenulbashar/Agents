    {
      "parameters": {
        "jsCode": "// Select rows that are APPROVED and DUE, and attach config values.\n// Review mode: a row is never touched unless a human set status = approved.\nconst cfg = {};\nfor (const c of $('Read config tab').all()) {\n  if (c.json.key) cfg[String(c.json.key).trim()] = String(c.json.value ?? '').trim();\n}\n\nconst now = Date.now();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  const status = String(r.status ?? '').trim().toLowerCase();\n  if (status !== 'approved') continue;\n\n  // scheduled_at empty means \"send at the next run\"\n  const when = String(r.scheduled_at ?? '').trim();\n  if (when) {\n    const t = Date.parse(when);\n    if (!isNaN(t) && t > now) continue;\n  }\n\n  const channel = String(r.channel ?? '').trim().toLowerCase();\n\n  // Per-channel kill switches from the config tab, e.g. x_paused = true\n  if (cfg[channel + '_paused'] === 'true') continue;\n\n  // X costs money per post ($0.015, $0.20 with a URL). Refuse to post a link\n  // unless the row was explicitly marked link_post.\n  if (channel === 'x') {\n    const isLink = String(r.link_post ?? '').trim().toLowerCase() === 'true';\n    const hasUrl = /https?:\\/\\//i.test(String(r.text ?? ''));\n    if (hasUrl && !isLink) continue;\n  }\n\n  out.push({\n    json: {\n      ...r,\n      channel,\n      ig_user_id: cfg.ig_user_id || '',\n      tiktok_open_id: cfg.tiktok_open_id || ''\n    }\n  });\n}\n\nreturn out;"
      },
